{
  "name": "backend-api",
  "version": "1.0.0",
  "description": "Phase 4 backend and APIs project",
  "main": "src/server.js",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "start": "nodemon src/server.js",
    "dev": "nodemon --env-file=.env src/server.js",
    "test": "node --import ./test/setup/setTestEnv.js --test",
    "test:coverage": "node --import ./test/setup/setTestEnv.js --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\"",
    "test:coverage:check": "node --import ./test/setup/setTestEnv.js --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95",
    "check:syntax": "node ./scripts/checkSyntax.js",
    "lint": "eslint src test scripts eslint.config.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:node": "node scripts/checkNodeVersion.js",
    "check": "npm run check:node && npm run check:syntax && npm run format:check && npm run lint && npm run test:coverage:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.5",
    "supertest": "^7.2.2"
  }
}
